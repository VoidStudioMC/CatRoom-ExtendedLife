+        }
+        if (destination != null) {
+            ((CraftInventory) destination.getTopInventory()).getInventory().onOpen(player);
+            ((CraftInventory) destination.getBottomInventory()).getInventory().onOpen(player);
+        }
+        // CatServer end
+    }
 
